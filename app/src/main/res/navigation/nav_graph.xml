<?xml version="1.0" encoding="utf-8"?>

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.LoginFragment"
        android:label="LOGIN" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />


        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.RegisterFragment"
        android:label="REGISTER" >

        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@+id/loginFragment"
            />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.CartFragment"
        android:label="Cart"
        tools:layout="@layout/fragment_cart" />

    <fragment
        android:id="@+id/orderFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.OrderFragment"
        android:label="Orders"
        tools:layout="@layout/fragment_orders" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/smartPhoneFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.SmartPhoneFragment"
        android:label="Smart Phones"
        tools:layout="@layout/fragment_smartphones">

        <argument
            android:name="categoryId"
            app:argType="string" />

        <argument
            android:name="categoryName"
            app:argType="string"
            />

    </fragment>

    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.ProductDetailsFragment"
        android:label="Details">

        <argument
            android:name="productId"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/searchResultFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.SearchResultFragment"
        android:label="Search Results">

        <argument
            android:name="searchText"
            app:argType="string" />

    </fragment>

    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.CheckoutFragment"
        android:label="CHECKOUT"
        tools:layout="@layout/fragment_checkout" />

    <fragment
        android:id="@+id/orderConfirmedFragment"
        android:name="com.code4galaxy.e_commerceapp.view.fragments.OrderConfirmedFragment"
        android:label="ORDER CONFIRMED">

        <argument
            android:name="orderId"
            app:argType="integer" />

    </fragment>

</navigation>