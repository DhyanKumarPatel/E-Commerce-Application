<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Delivery Address"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#555555"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- HOME ADDRESS -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeAddressContainer"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_address"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <TextView
            android:id="@+id/tvHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOME"
            android:textSize="14sp"
            android:textColor="#B0B7C3"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHomeAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="16dp"
            android:text="402 W. Marine Way, Suite 100, Ships Building,\nKodiak, Kodiak Island, AK, 99615"
            android:textSize="11sp"
            android:textColor="#555555"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHome"
            app:layout_constraintEnd_toStartOf="@id/radioHome" />

        <RadioButton
            android:id="@+id/radioHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#42A5F5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- OFFICE ADDRESS -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/officeAddressContainer"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_address"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeAddressContainer">

        <TextView
            android:id="@+id/tvOffice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFICE"
            android:textSize="14sp"
            android:textColor="#B0B7C3"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOfficeAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="16dp"
            android:text="1865 E Parks Highway, Cottonwood Creek Mall,\nWasilla, AK 99654"
            android:textSize="11sp"
            android:textColor="#555555"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOffice"
            app:layout_constraintEnd_toStartOf="@id/radioOffice" />

        <RadioButton
            android:id="@+id/radioOffice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#42A5F5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ADD ADDRESS BUTTON -->

    <Button
        android:id="@+id/btnAddAddress"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="ADD ADDRESS"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:letterSpacing="0.12"
        android:backgroundTint="#42A5F5"
        app:cornerRadius="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnNext"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- NEXT BUTTON -->

    <Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:text="NEXT"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:letterSpacing="0.12"
        android:backgroundTint="#42A5F5"
        app:cornerRadius="8dp"
        app:layout_constraintStart_toEndOf="@id/btnAddAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>